-- Read a text file from a local file path
readFileToString :: FilePath -> IO String
readFileToString = readFile

testTokenise :: IO ()
-- testTokenise :: [String]
testTokenise = do
    bookFileLocation :: String
    -- https://en.wikisource.org/wiki/The_Verdict
    bookFileLocation = "C:/git/haskell-llm/data/TheVerdict.txt"
    -- Test with a local file:
    content <- readFileToString bookFileLocation
    putStrLn "First 100 token Ids:"
    let tokens :: [String]
      tokens = tokenise content in
        let tokenMapper :: Map.Map String Int
          tokenMapper = tokenToIdMapper tokens in
            let tokenIds :: [Int]
              tokenIds = map (tokenMapper Map.!) tokens in
                let idToTokenMap :: Map.Map Int String
                  idToTokenMap = idToTokenMapper tokenMapper in
                  let tokenStrings :: [String]
                      tokenStrings = map (idToTokenMap Map.!) tokenIds in
                          print (take 100 tokenStrings)
    return ()