-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'haskell-llm' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               haskell-llm

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
synopsis:           A basic Large Language Model written in Haskell

-- A longer description of the package.
description:        A basic Large Language Model in Haskell. The aim is to aid the understanding of how LLMs work by capturing their basic functionality without performance optimisations. 
                    It is based on the description of LLMs in Sebastian Raschka's book "Build a Large Language Model (From Scratch)", Manning Publications Co, 2025, ISBN 9781633437166.

-- The license under which the package is released.
license:            Apache-2.0

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Paul Watson

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         paul.watson@newcastle.ac.uk

copyright:          2026 Newcastle University
category:           Development
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable haskell-llm
    import:           warnings
    main-is:          Main.hs
    other-modules:    Tokenise, InputTargetPairs, Embeddings, PositionalEmbeddings
    build-depends:    base >= 4.7
--                    , http-conduit
--                     , bytestring
                    , containers
                    , split
                    , matrix
                    , random
                    , vector
--                    , template-haskell
                    , ghc-typelits-extra
                    , ghc-typelits-knownnat
                    , ghc-typelits-natnormalise
--                    , torch
--                    , mtl
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -fplugin GHC.TypeLits.Normalise -fplugin GHC.TypeLits.KnownNat.Solver -fplugin GHC.TypeLits.Extra.Solver -fconstraint-solver-iterations=0 -rtsopts

executable tastyTest
    import:           warnings
    main-is:          tastyTest.hs
    other-modules: Tokenise, InputTargetPairs, Embeddings, PositionalEmbeddings

    -- Other library packages from which modules are imported.
    build-depends:    base >= 4.7
                    , tasty
                    , tasty-hunit
                    , tasty-smallcheck
                    , tasty-quickcheck
                    , containers
                    , split
                    , text
                    , vector
                    , random
                    , matrix

    -- Directories containing source files.
    hs-source-dirs:   app

    -- Base language which the package is written in.
    default-language: Haskell2010
